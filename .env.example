# ---------------------------------------------------------------------------
# CampusConnect - example environment file
# Copy this file to `.env` in the repository root and replace the placeholders.
# Never commit the real `.env` file.
#
# Local development uses the values in the "development" block.
# The production block at the bottom shows what a Lightsail + AuraDB deployment
# needs; the API refuses to start in production with development defaults.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Port the Express API listens on. In production Nginx proxies to this port and
# the port is never exposed to the internet.
PORT=4000

# Interface the API binds to. Leave it empty and the API binds 0.0.0.0 in
# development and 127.0.0.1 in production, so a deployed API is only reachable
# through Nginx.
# HOST=127.0.0.1

# Public origin of the frontend. Used for CORS and for the CSRF/cookie policy.
# Development: the Vite dev server. Production: your https:// site origin,
# with no trailing slash.
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Neo4j connection (Bolt). Only the backend reads these values; they are never
# exposed to Vite. For AuraDB Free use the neo4j+s:// URI from the Aura console.
# ---------------------------------------------------------------------------
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Sessions
# SESSION_SECRET must be a long random string (32+ characters locally,
# 48+ in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
SESSION_COOKIE_NAME=cc.sid
SESSION_TTL_HOURS=168

# Set to true only when serving over HTTPS (e.g. behind a TLS-terminating proxy).
COOKIE_SECURE=false

# Set to true when the API runs behind a reverse proxy so rate limiting and
# secure cookies see the real client IP and protocol.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Production checklist — NODE_ENV=production enforces every one of these.
# The API exits with a clear message instead of running with unsafe defaults.
#   NODE_ENV=production
#   WEB_ORIGIN=https://your-subdomain.duckdns.org     (https, no trailing slash)
#   COOKIE_SECURE=true
#   TRUST_PROXY=true
#   NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
#   SESSION_SECRET=<48+ random characters>
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Optional: isolated Neo4j instance used by the DB-backed integration tests.
# When this is empty the integration test suite is skipped (unit tests still run).
# ---------------------------------------------------------------------------
TEST_NEO4J_URI=
TEST_NEO4J_USERNAME=
TEST_NEO4J_PASSWORD=
TEST_NEO4J_DATABASE=
