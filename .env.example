# ---------------------------------------------------------------------------
# CampusConnect - example environment file
# Copy this file to `.env` in the repository root and replace the placeholders.
# Never commit the real `.env` file.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# Origin of the Vite dev server. Used for CORS and for cookie/CSRF decisions.
WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Neo4j connection (Bolt). Only the backend reads these values.
# ---------------------------------------------------------------------------
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Sessions
# SESSION_SECRET must be a long random string (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
SESSION_COOKIE_NAME=cc.sid
SESSION_TTL_HOURS=168

# Set to true only when serving over HTTPS (e.g. behind a TLS-terminating proxy).
COOKIE_SECURE=false

# Set to 1 when the API runs behind a reverse proxy so rate limiting sees real IPs.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Optional: isolated Neo4j instance used by the DB-backed integration tests.
# When this is empty the integration test suite is skipped (unit tests still run).
# ---------------------------------------------------------------------------
TEST_NEO4J_URI=
TEST_NEO4J_USERNAME=
TEST_NEO4J_PASSWORD=
TEST_NEO4J_DATABASE=
