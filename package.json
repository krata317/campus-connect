{
  "name": "campusconnect",
  "private": true,
  "version": "1.0.0",
  "description": "CampusConnect - college placement management portal (React + Express + TypeScript + Neo4j)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @campusconnect/api",
    "dev:web": "npm run dev --workspace @campusconnect/web",
    "db:check": "npm run db:check --workspace @campusconnect/api",
    "db:init": "npm run db:init --workspace @campusconnect/api",
    "db:test-setup": "npm run db:test-setup --workspace @campusconnect/api",
    "admin:bootstrap": "npm run admin:bootstrap --workspace @campusconnect/api",
    "build": "npm run build --workspace @campusconnect/web",
    "build:api": "npm run build --workspace @campusconnect/api",
    "start:api": "npm run start --workspace @campusconnect/api",
    "test": "npm run test --workspace @campusconnect/api && npm run test --workspace @campusconnect/web",
    "test:api": "npm run test --workspace @campusconnect/api",
    "test:web": "npm run test --workspace @campusconnect/web",
    "typecheck": "npm run typecheck --workspace @campusconnect/shared && npm run typecheck --workspace @campusconnect/api && npm run typecheck --workspace @campusconnect/web"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.64.12",
    "concurrently": "^9.0.1"
  }
}
